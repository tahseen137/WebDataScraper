# Supabase Configuration
# Get these from your Supabase project: Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Note: Use the service_role key (not anon key) for write access
# The service_role key bypasses Row Level Security
# Find it in: Supabase Dashboard → Settings → API → service_role

# Scraper Configuration (all optional, defaults shown)
SCRAPER_DELAY=2.0                    # Default delay between requests (seconds)
SCRAPER_MIN_DELAY=1.0               # Minimum delay (seconds)
SCRAPER_MAX_DELAY=10.0              # Maximum delay (seconds)
SCRAPER_TIMEOUT=15                  # Request timeout (seconds)
SCRAPER_MAX_RETRIES=3               # Maximum retry attempts
SCRAPER_RETRY_BACKOFF=2.0           # Exponential backoff multiplier
MIN_CONFIDENCE_THRESHOLD=0.3        # Minimum confidence for uploading cards

# Logging Configuration
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=true                    # Write logs to file
LOG_DIR=logs                        # Log file directory
